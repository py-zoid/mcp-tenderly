# Copy to .env and fill in. Never commit .env.
#
# Tenderly access key. Dashboard -> Account Settings -> Access Tokens.
# This is a personal token, not the project-scoped "secret" used by RPC nodes.
TENDERLY_API_KEY=

# The account (user or organisation) that owns the project. Read it out of your
# dashboard URL: https://dashboard.tenderly.co/<ACCOUNT_SLUG>/<PROJECT_SLUG>
TENDERLY_ACCOUNT_SLUG=

# The project slug from the same URL. Note this is the slug, not the display
# name — a project shown as "My Project" is usually "my-project" here.
TENDERLY_PROJECT_SLUG=

# ---- Optional ----

# Persist simulations to the Tenderly dashboard so each result carries a
# shareable URL. Costs one stored simulation against the free-tier quota per
# call; set to false to keep simulations ephemeral. Default: true.
# TENDERLY_SAVE_SIMULATIONS=true

# Log level on stderr: debug | info | warn | error. Default: info.
# TENDERLY_LOG_LEVEL=info

# Request timeout in milliseconds. Default: 30000.
# TENDERLY_TIMEOUT_MS=30000
