{
  "name": "mcp-tenderly",
  "version": "0.1.0",
  "description": "MCP server for Tenderly transaction simulation and trace debugging on EVM chains",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tenderly",
    "ethereum",
    "evm",
    "simulation",
    "debugging",
    "web3"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "mcp-tenderly": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude \"tests/stdio-smoke.test.ts\"",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "test:smoke": "npm run build && vitest run tests/stdio-smoke.test.ts",
    "test:all": "npm run test && npm run test:smoke",
    "prepare": "bash scripts/setup-hooks.sh",
    "verify": ".github/scripts/verify.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
