#!/usr/bin/env bash
#
# Enforces Conventional Commits. Kept as a regex rather than a commitlint
# dependency: the rule is one line, and a hook nobody can read is a hook nobody
# trusts.
set -euo pipefail

message_file="$1"
subject=$(head -n1 "$message_file")

# Merge, revert and fixup subjects are generated by git itself.
if echo "$subject" | grep -qE '^(Merge|Revert|fixup!|squash!) '; then
  exit 0
fi

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+'

if ! echo "$subject" | grep -qE "$pattern"; then
  cat >&2 <<MSG

Commit message must follow Conventional Commits:

  type(optional-scope): description

Valid types: build chore ci docs feat fix perf refactor revert style test

Rejected subject:
  $subject

MSG
  exit 1
fi

if [ ${#subject} -gt 100 ]; then
  echo "Commit subject is ${#subject} characters; keep it under 100." >&2
  exit 1
fi
